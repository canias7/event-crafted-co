# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Playwright artifacts — per-test traces, screenshots, error contexts,
# HTML report. Local-only output of `npm run test:e2e`.
test-results/
playwright-report/
playwright/.cache/

# Environment files — contents are publishable (anon key + URL),
# but secrets (Anthropic, service role) belong only in Supabase secrets.
# .env committed so published build has Supabase URL+anon key
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# don't commit raw icon source — only the generated variants
apps/*/assets/icon-source.png

# Stray app.json that EAS CLI sometimes creates at repo root when cwd isn't a mobile app
/app.json
pnpm-lock.yaml

# Supabase CLI scratch dir (cli-latest, linked-project.json). Created
# when running `supabase functions deploy` locally.
supabase/.temp/

# Playwright authenticated storage state (contains session tokens)
apps/web/tests/e2e/.auth/
