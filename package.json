{
  "name": "vendora-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "ajv": "^8.12.0",
    "react-native-css-interop": "0.1.22",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "@types/react": "~19.2.0"
  },
  "trustedDependencies": [],
  "scripts": {
    "postinstall": "bash scripts/apply-patches.sh",
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "build:dev": "npm run build:dev --workspace=apps/web",
    "preview": "npm run preview --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "typecheck:all": "npm run typecheck --workspace=apps/web && npm run typecheck --workspace=apps/admin && npm run typecheck --workspace=apps/vendor-mobile && npm run typecheck --workspace=apps/host-mobile",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build:admin": "npm run build --workspace=apps/admin",
    "mobile:vendor": "npm run start --workspace=apps/vendor-mobile",
    "mobile:vendor:tunnel": "npm run start --workspace=apps/vendor-mobile -- --tunnel",
    "mobile:vendor:android": "npm run start --workspace=apps/vendor-mobile -- --android",
    "mobile:vendor:ios": "npm run start --workspace=apps/vendor-mobile -- --ios",
    "mobile:host": "npm run start --workspace=apps/host-mobile",
    "mobile:host:tunnel": "npm run start --workspace=apps/host-mobile -- --tunnel",
    "mobile:host:android": "npm run start --workspace=apps/host-mobile -- --android",
    "mobile:host:ios": "npm run start --workspace=apps/host-mobile -- --ios",
    "test": "npm run test --workspace=apps/web",
    "test:watch": "npm run test:watch --workspace=apps/web",
    "test:e2e": "npm run test:e2e --workspace=apps/web"
  }
}
