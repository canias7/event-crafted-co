{
  "name": "@vendora/vendor-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "eas-build-pre-install": "cd ../.. && bun install --ignore-scripts && bash scripts/apply-patches.sh",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:android": "eas build --profile production --platform android",
    "build:ios": "eas build --profile production --platform ios",
    "build:all": "eas build --profile production --platform all",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "submit:android": "eas submit --profile production --platform android",
    "submit:ios": "eas submit --profile production --platform ios",
    "submit:all": "eas submit --profile production --platform all"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.105.1",
    "@vendora/core": "*",
    "expo": "~55.0.0",
    "expo-constants": "~55.0.0",
    "expo-device": "~55.0.0",
    "expo-image-manipulator": "~55.0.17",
    "expo-image-picker": "~55.0.0",
    "expo-linking": "~55.0.0",
    "expo-media-library": "~55.0.0",
    "expo-notifications": "~55.0.0",
    "expo-router": "~55.0.0",
    "expo-secure-store": "~55.0.0",
    "expo-status-bar": "~55.0.0",
    "expo-updates": "~55.0.0",
    "expo-video": "~55.0.0",
    "expo-video-thumbnails": "~55.0.0",
    "expo-web-browser": "~55.0.0",
    "nativewind": "^4.1.23",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.10"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
