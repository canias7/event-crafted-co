{
  "expo": {
    "name": "Vendora",
    "slug": "vendora-host",
    "scheme": "vendora-host",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "bundleIdentifier": "co.eventcrafted.host",
      "supportsTablet": true
    },
    "android": {
      "package": "co.eventcrafted.host"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
