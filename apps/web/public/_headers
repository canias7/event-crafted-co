# Cloudflare Pages response headers (ports the vercel.json `headers` block).
#
# Default: never cache HTML / the SPA shell, so deploys go live instantly.
/*
  Cache-Control: no-cache, no-store, must-revalidate

# Hashed build assets are immutable — cache them forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Rendered event pages. The /s/<slug> Function also sets this itself; this
# more-specific rule ensures the `/*` no-store default never wins here even
# if _headers is applied to the Function response.
/s/*
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=300
