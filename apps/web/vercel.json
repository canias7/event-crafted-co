{
  "rewrites": [
    { "source": "/preview/:path*", "destination": "/preview/:path*" },
    {
      "source": "/s/:slug",
      "destination": "https://pahpjjubhbcbwqjpamwv.supabase.co/functions/v1/ai-site-render?slug=:slug"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
