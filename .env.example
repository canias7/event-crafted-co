VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Optional. When set, errors flow to Sentry. Get the DSN from your Sentry
# project under Settings > Projects > <project> > Client Keys (DSN).
VITE_SENTRY_DSN=""

# Stripe publishable key. Safe to expose in the client bundle. Get it
# from https://dashboard.stripe.com/test/apikeys (test mode) or
# /apikeys (live mode). The matching SECRET key must be set as a
# Supabase Edge Function secret named STRIPE_SECRET_KEY — never
# committed here.
VITE_STRIPE_PUBLISHABLE_KEY=""
