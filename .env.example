VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Optional. When set, errors flow to Sentry. Get the DSN from your Sentry
# project under Settings > Projects > <project> > Client Keys (DSN).
VITE_SENTRY_DSN=""

# ─── VendoraPay (Phase 1) ────────────────────────────────────────────
# See VENDORAPAY_README.md at repo root for the full Stripe dashboard
# setup walkthrough.
#
# Frontend (this file): publishable key only — safe to embed in the
# browser bundle. Get it from https://dashboard.stripe.com/test/apikeys
# (test mode) or /apikeys (live mode).
VITE_STRIPE_PUBLISHABLE_KEY=""

# Server (set as Supabase Edge Function secrets, NOT in this file):
#   STRIPE_SECRET_KEY            sk_test_... / sk_live_...
#   STRIPE_WEBHOOK_SECRET        whsec_... (from Stripe dashboard webhook endpoint)
#   VENDORAPAY_FEE_BPS           Platform fee in basis points (default 500 = 5%)
#   VENDORAPAY_FEE_FIXED_CENTS   Optional flat-cent fee on top (default 0)
#   APP_URL                      Base URL of the React app (default https://eventvendora.com)
